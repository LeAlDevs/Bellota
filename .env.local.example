# Copiá este archivo como .env.local y completá con los valores del proyecto Supabase.
# (Supabase -> Project Settings -> API)

# URL del proyecto (https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key (segura para el browser, respeta RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key (SECRETA, solo servidor, SALTEA RLS). NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=
